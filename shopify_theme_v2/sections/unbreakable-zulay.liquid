<!-- CTA -->
<section class="airy-section reveal" style="text-align: center; background: var(--bg-alt); padding: 6rem 2rem;">
    <div style="max-width: 700px; margin: 0 auto;">
        <span class="kicker">SUR COMMANDE</span>
        <h2 style="font-size: 2.5rem; margin-bottom: 3rem; font-family: var(--font-serif); font-weight: 400;">Chaque Pièce, Unique</h2>
        <p style="color: var(--muted); font-size: 1rem; line-height: 2; margin-bottom: 4rem;">
            Toutes les créations de la collection Zulay Pogba sont disponibles sur commande. Contactez notre équipe pour organiser une présentation privée dans notre showroom genevois.
        </p>
        <a href="/pages/contact" class="btn-outline" style="display: inline-block; padding: 1rem 2rem; border: 1px solid var(--border); text-decoration: none; color: var(--fg); text-transform: uppercase; letter-spacing: 0.15em; font-size: 0.8rem;">Prendre rendez-vous</a>
    </div>
</section>

{% schema %}
{
  "name": "Unbreakable Zulay",
  "settings": []
