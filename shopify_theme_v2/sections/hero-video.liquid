<div class="hero-video-container" role="banner">
    <video autoplay muted loop playsinline class="video-full-bg" aria-hidden="true">
        <source src="https://cdn.shopify.com/videos/c/o/v/5dcc0929850b4fbea015c0e5b29ea8a4.mp4" type="video/mp4">
    </video>
    <div class="hero-content">
        <span class="kicker kicker--light fade-in" style="font-size:1.95rem;">MAISON ELKE BERR — GENÈVE</span>
        <div style="width:60px;height:1px;background:rgba(255,255,255,0.4);margin:0 auto 3.5rem;" class="fade-in fade-in-delay-1"></div>
        <a href="/collections/all" class="btn-outline btn-outline--light fade-in fade-in-delay-2">Découvrir le Showroom</a>
    </div>
    <div class="hero-scroll-cue" aria-hidden="true">
        <div class="scroll-line"></div>
        <span>Défiler</span>
    </div>
</div>

