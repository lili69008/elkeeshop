<style>
    .collection-intro { max-width: 800px; margin: 4rem auto; text-align: center; padding: 0 2rem; }
</style>

<!-- Hero -->
<div class="hero-video-container hero-collection" style="background: url('{{ 'unbreakable_hero.png' | asset_url }}') no-repeat center top; background-size: cover; height: 80vh;">
    <div class="hero-overlay"></div>
    <div class="hero-content">
        <span class="kicker kicker--light">CO-CRÉATION EXCLUSIVE</span>
        <h1>PAUL POGBA<span>× ELKE BERR</span></h1>
        <div class="hero-divider"></div>
        <p>Unbreakable Collection</p>
    </div>
</div>

<section class="collection-intro reveal">
    <p>La collection Paul Pogba "Unbreakable" est une ode à la ténacité. Des bijoux de caractère en argent massif, façonnés pour durer toute une vie. Chaque pièce incarne la force et la résilience, signature de cette collaboration exclusive.</p>
</section>

<!-- Colliers & Pendentifs -->
<section class="reveal" style="padding: 4vw 8vw 2vw;">
    <div class="category-header" style="border-bottom: 1px solid var(--border); padding-bottom: 1.5rem; margin-bottom: 3.5rem; margin-top: 2rem;">
        <span class="kicker" style="margin-bottom: 0.5rem;">CO-CRÉATION PAUL POGBA</span>
        <h2 style="font-family: var(--font-serif); font-size: 2.2rem; font-weight: 300; letter-spacing: 0.05em; color: var(--fg); text-transform: uppercase;">Colliers &amp; Pendentifs</h2>
    </div>
    <div class="grid-3">
        {% assign items = "unbreakable-silver|UNBREAKABLE NECKLACE|1_7e5702ad-2f97-4021-b1e4-a3ea31f3e6db.png,unbreakable-white-black|UNBREAKABLE NECKLACE - SILVER & BLACK|9_ecfbc702-9d06-4d9b-84b6-41a1985678ab.png,unbreakable-black-white|UNBREAKABLE NECKLACE - BLACK & SILVER|5_843956db-98ff-42b9-94ce-54c003d49c8a.png,ubreakable-pendant-only|UNBREAKABLE - PENDANT ONLY|DSC_2911-2.jpg,phoenix|PHOENIX NECKLACE|BIJOUXZULAYSITE.png,phoenix-necklace-onyx|PHOENIX NECKLACE - BLACK SPINEL|Phoenixnecklaceonyx.png,imperium|IMPERIUM NECKLACE - SILVER|3_63d4f54a-a0e0-4aa7-b77a-b6d97ef40bcd.png,unbreakable-necklace-gold-diamonds|UNBREAKABLE NECKLACE - GOLD & DIAMONDS|CollierPaul4.png,phoenix-necklace-copie|PHOENIX NECKLACE - GOLD & DIAMONDS|BIJOUXZULAYSITE.png,imperium-necklace-gold|IMPERIUM NECKLACE - GOLD & DIAMONDS|3_63d4f54a-a0e0-4aa7-b77a-b6d97ef40bcd.png,olympia|OLYMPIA|2_733f4f82-3fac-416f-bee6-53a55fcaf7bb.png" | split: "," %}
        {% for item in items %}
            {% assign parts = item | split: "|" %}
            {% assign handle = parts[0] %}
            {% assign title = parts[1] %}
            {% assign img = parts[2] %}
            {% assign product = all_products[handle] %}
            
            <a href="{% if product != empty %}{{ product.url }}{% else %}/products/{{ handle }}{% endif %}" style="text-decoration:none; color:inherit;" class="bg-lifestyle">
                <div class="card reveal">
                    <div class="card-img-wrapper">
                        {% if product != empty and product.featured_image %}
                            <img src="{{ product.featured_image | img_url: 'large' }}" alt="{{ title }}">
                        {% else %}
                            <img src="{{ img | asset_url }}" alt="{{ title }}">
                        {% endif %}
                    </div>
                    <span class="kicker">{% if title contains 'PHOENIX' %}PHOENIX{% elsif title contains 'IMPERIUM' %}IMPERIUM{% elsif title contains 'OLYMPIA' %}OLYMPIA HIGH JEWELRY{% else %}UNBREAKABLE{% endif %}</span>
                    <h3>{{ title }}</h3>
                </div>
            </a>
        {% endfor %}
    </div>
</section>

<!-- Bagues -->
<section class="reveal" style="padding: 4vw 8vw 2vw;">
    <div class="category-header" style="border-bottom: 1px solid var(--border); padding-bottom: 1.5rem; margin-bottom: 3.5rem;">
        <span class="kicker" style="margin-bottom: 0.5rem;">CO-CRÉATION PAUL POGBA</span>
        <h2 style="font-family: var(--font-serif); font-size: 2.2rem; font-weight: 300; letter-spacing: 0.05em; color: var(--fg); text-transform: uppercase;">Bagues</h2>
    </div>
    <div class="grid-3">
        {% assign items_rings = "ring-unbreakable|UNBREAKABLE RING|1_9ba496c6-bf4a-4cfa-be5d-e1710fcff119.png,phoenix-ring|PHOENIX RING|6_a0fc6cea-1726-4b5f-bf4f-1d0086e6129d.png" | split: "," %}
        {% for item in items_rings %}
            {% assign parts = item | split: "|" %}
            {% assign handle = parts[0] %}
            {% assign title = parts[1] %}
            {% assign img = parts[2] %}
            {% assign product = all_products[handle] %}
            <a href="{% if product != empty %}{{ product.url }}{% else %}/products/{{ handle }}{% endif %}" style="text-decoration:none; color:inherit;" class="bg-lifestyle">
                <div class="card reveal">
                    <div class="card-img-wrapper">
                        {% if product != empty and product.featured_image %}
                            <img src="{{ product.featured_image | img_url: 'large' }}" alt="{{ title }}">
                        {% else %}
                            <img src="{{ img | asset_url }}" alt="{{ title }}">
                        {% endif %}
                    </div>
                    <span class="kicker">{% if title contains 'PHOENIX' %}PHOENIX{% else %}UNBREAKABLE{% endif %}</span>
                    <h3>{{ title }}</h3>
                </div>
            </a>
        {% endfor %}
    </div>
</section>

<!-- Bracelets -->
<section class="reveal" style="padding: 4vw 8vw 2vw;">
    <div class="category-header" style="border-bottom: 1px solid var(--border); padding-bottom: 1.5rem; margin-bottom: 3.5rem;">
        <span class="kicker" style="margin-bottom: 0.5rem;">CO-CRÉATION PAUL POGBA</span>
        <h2 style="font-family: var(--font-serif); font-size: 2.2rem; font-weight: 300; letter-spacing: 0.05em; color: var(--fg); text-transform: uppercase;">Bracelets</h2>
    </div>
    <div class="grid-3">
        <a href="/products/bracelet-unbreakable" style="text-decoration:none; color:inherit;" class="bg-lifestyle">
            <div class="card reveal">
                <div class="card-img-wrapper"><img src="{{ '3_e2d9b7f0-daf3-4f06-a6ee-2bff0d5254b0.png' | asset_url }}" alt="UNBREAKABLE BRACELET"></div>
                <span class="kicker">UNBREAKABLE</span>
                <h3>UNBREAKABLE BRACELET</h3>
            </div>
        </a>
    </div>
</section>

<!-- Boucles d'oreilles -->
<section class="reveal" style="padding: 4vw 8vw 6vw;">
    <div class="category-header" style="border-bottom: 1px solid var(--border); padding-bottom: 1.5rem; margin-bottom: 3.5rem;">
        <span class="kicker" style="margin-bottom: 0.5rem;">CO-CRÉATION PAUL POGBA</span>
        <h2 style="font-family: var(--font-serif); font-size: 2.2rem; font-weight: 300; letter-spacing: 0.05em; color: var(--fg); text-transform: uppercase;">Boucles d'oreilles</h2>
    </div>
    <div class="grid-3">
        <a href="/products/unbreakable-earrings" style="text-decoration:none; color:inherit;" class="bg-lifestyle">
            <div class="card reveal">
                <div class="card-img-wrapper"><img src="{{ 'BIJOUXZULAYSITE_3_e04e1f0d-8616-41bd-85b9-40edf0e44506.png' | asset_url }}" alt="UNBREAKABLE EARRINGS"></div>
                <span class="kicker">UNBREAKABLE</span>
                <h3>UNBREAKABLE EARRINGS</h3>
            </div>
        </a>
        <a href="/products/phoenix-earrings" style="text-decoration:none; color:inherit;" class="bg-lifestyle">
            <div class="card reveal">
                <div class="card-img-wrapper"><img src="{{ '5_2ebff012-615d-4ff7-8670-d561d31de8ee.png' | asset_url }}" alt="PHOENIX EARRINGS"></div>
                <span class="kicker">PHOENIX</span>
                <h3>PHOENIX EARRINGS</h3>
            </div>
        </a>
    </div>
</section>

{% schema %}
{
  "name": "Unbreakable Paul",
  "settings": []
}
{% endschema %}
