<section class="reveal flush-section" style="padding:0;background:#000;height:80vh;position:relative;overflow:hidden;display:flex;align-items:center;justify-content:center;">
    <video autoplay muted loop playsinline style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0.45;" aria-hidden="true">
        <source src="https://cdn.shopify.com/videos/c/o/v/78a9e26ace7b4160a614f82bf3b37297.mp4" type="video/mp4">
    </video>
    <div style="position:relative;z-index:1;text-align:center;color:#fff;padding:0 10vw;">
        <span class="kicker kicker--light">CO-CRÉATION EXCLUSIVE</span>
        <h2 style="font-family:var(--font-display);color:#fff;font-size:clamp(3rem,8vw,6.5rem);font-weight:300;letter-spacing:0.15em;text-transform:uppercase;margin:1.5rem 0;">Unbreakable</h2>
        <p style="color:rgba(255,255,255,0.65);margin:0 0 3.5rem;letter-spacing:0.35em;text-transform:uppercase;font-size:0.75rem;">La Résilience Transformée en Éclat</p>
        <a href="/pages/unbreakable" class="btn-outline btn-outline--light">Voir la Collection</a>
    </div>
</section>

