    <script>
        const observerOptions = { threshold: 0.1 };
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) entry.target.classList.add('reveal');
            });
        }, observerOptions);
        document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

        // Moteur de Variantes & Galerie Universelle
        document.addEventListener('DOMContentLoaded', () => {
            const thumbnails = document.querySelectorAll('.thumbnail-item');
            const mainImages = document.querySelectorAll('.gallery-main-view img');
            
            function showImage(index) {
                if (index === null || index === undefined || index === -1 || index === "") return;
                thumbnails.forEach(thumb => thumb.classList.remove('active'));
                mainImages.forEach(img => img.classList.remove('active'));
                
                const selectedThumb = document.querySelector(`.thumbnail-item[data-index="${index}"]`);
                const selectedImg = document.getElementById(`main-img-${index}`);
                
                if (selectedThumb) selectedThumb.classList.add('active');
                if (selectedImg) selectedImg.classList.add('active');
            }
            
            thumbnails.forEach(thumb => {
                thumb.addEventListener('click', () => {
                    const index = thumb.getAttribute('data-index');
                    showImage(index);
                });
            });

            // Parse variants data
            const rawData = document.getElementById('product-variants-data').textContent;
            let variantsData = null;
            try {
                variantsData = JSON.parse(rawData);
            } catch (e) {
                console.log('No variant data or failed parsing:', e);
            }

            if (variantsData) {
                const container = document.getElementById('variant-selector-container');
                const priceDisplay = document.getElementById('variant-price-display');
                const metalSpec = document.getElementById('spec-metal-val');
                
                let selectedColor = null;
                let selectedSize = null;
                let selectedOther = null;

                function updateSelection() {
                    if (!variantsData.variants) return;
                    
                    // Find matching variant
                    const match = variantsData.variants.find(v => {
                        let colorMatch = !variantsData.hasColors || v.color === selectedColor;
                        let sizeMatch = !variantsData.hasSizes || v.size === selectedSize;
                        let otherMatch = !variantsData.hasOther || v.other === selectedOther;
                        return colorMatch && sizeMatch && otherMatch;
                    });

                    if (match) {
                        if (priceDisplay && match.price) {
                            priceDisplay.textContent = match.price;
                        }
                        if (match.imageIndex !== undefined && match.imageIndex !== -1 && match.imageIndex !== "") {
                            showImage(match.imageIndex);
                        }
                    }
                }

                // 1. Build Colors swatch group
                if (variantsData.hasColors && variantsData.colors && variantsData.colors.length > 0) {
                    const grp = document.createElement('div');
                    grp.className = 'selector-group';
                    
                    const lbl = document.createElement('div');
                    lbl.className = 'selector-label';
                    lbl.innerHTML = `Couleur de l'or : <span id="color-name-label"></span>`;
                    grp.appendChild(lbl);
                    
                    const row = document.createElement('div');
                    row.className = 'swatches-row';
                    
                    variantsData.colors.forEach((c, idx) => {
                        const item = document.createElement('div');
                        item.className = 'swatch-item';
                        if (idx === 0) {
                            item.classList.add('active');
                            selectedColor = c.value;
                            lbl.querySelector('span').textContent = c.label;
                            if (metalSpec && c.spec) metalSpec.textContent = c.spec;
                        }
                        item.style.backgroundColor = c.hex || '#D4AF37';
                        item.title = c.label;
                        
                        item.addEventListener('click', () => {
                            row.querySelectorAll('.swatch-item').forEach(s => s.classList.remove('active'));
                            item.classList.add('active');
                            selectedColor = c.value;
                            lbl.querySelector('span').textContent = c.label;
                            
                            // Specific gold type mapping to spec metal
                            if (metalSpec) {
                                if (c.value.includes('rose')) metalSpec.textContent = 'Or Rose 18K';
                                else if (c.value.includes('jaune') || c.value.includes('yellow')) metalSpec.textContent = 'Or Jaune 18K';
                                else if (c.value.includes('blanc') || c.value.includes('white')) metalSpec.textContent = 'Or Blanc 18K';
                                else if (c.spec) metalSpec.textContent = c.spec;
                            }
                            
                            if (c.imageIndex !== undefined && c.imageIndex !== -1 && c.imageIndex !== "") {
                                showImage(c.imageIndex);
                            }
                            
                            updateSelection();
                        });
                        row.appendChild(item);
                    });
                    grp.appendChild(row);
                    container.appendChild(grp);
                }

                // 2. Build Other Options (e.g. Chain Design)
                if (variantsData.hasOther && variantsData.otherOptions && variantsData.otherOptions.length > 0) {
                    const grp = document.createElement('div');
                    grp.className = 'selector-group';
                    
                    const lbl = document.createElement('div');
                    lbl.className = 'selector-label';
                    lbl.innerHTML = `${variantsData.otherName || 'Option'} : <span id="other-name-label"></span>`;
                    grp.appendChild(lbl);
                    
                    const row = document.createElement('div');
                    row.className = 'options-row';
                    
                    variantsData.otherOptions.forEach((o, idx) => {
                        const btn = document.createElement('button');
                        btn.className = 'option-btn';
                        if (idx === 0) {
                            btn.classList.add('active');
                            selectedOther = o.value;
                            lbl.querySelector('span').textContent = o.label;
                        }
                        btn.textContent = o.label;
                        
                        btn.addEventListener('click', () => {
                            row.querySelectorAll('.option-btn').forEach(b => b.classList.remove('active'));
                            btn.classList.add('active');
                            selectedOther = o.value;
                            lbl.querySelector('span').textContent = o.label;
                            
                            if (o.imageIndex !== undefined && o.imageIndex !== -1 && o.imageIndex !== "") {
                                showImage(o.imageIndex);
                            }
                            
                            updateSelection();
                        });
                        row.appendChild(btn);
                    });
                    grp.appendChild(row);
                    container.appendChild(grp);
                }

                // 3. Build Sizes buttons
                if (variantsData.hasSizes && variantsData.sizes && variantsData.sizes.length > 0) {
                    const grp = document.createElement('div');
                    grp.className = 'selector-group';
                    
                    const lbl = document.createElement('div');
                    lbl.className = 'selector-label';
                    lbl.innerHTML = `Taille : <span id="size-name-label"></span>`;
                    grp.appendChild(lbl);
                    
                    const row = document.createElement('div');
                    row.className = 'options-row';
                    
                    variantsData.sizes.forEach((s, idx) => {
                        const btn = document.createElement('button');
                        btn.className = 'option-btn';
                        if (idx === 0) {
                            btn.classList.add('active');
                            selectedSize = s.value;
                            lbl.querySelector('span').textContent = s.label;
                        }
                        btn.textContent = s.label;
                        
                        btn.addEventListener('click', () => {
                            row.querySelectorAll('.option-btn').forEach(b => b.classList.remove('active'));
                            btn.classList.add('active');
                            selectedSize = s.value;
                            lbl.querySelector('span').textContent = s.label;
                            
                            updateSelection();
                        });
                        row.appendChild(btn);
                    });
                    grp.appendChild(row);
                    container.appendChild(grp);
                }
            }
        });
    </script>
</body>
</html>
